---
import type { ContentBlock } from '../../types/article';

interface Props {
  blocks: ContentBlock[];
}

const { blocks } = Astro.props;
---

<div class="article-body font-display text-lg leading-relaxed text-ink-800 dark:text-ink-100">
  {blocks.map((block) => {
    switch (block.type) {
      case 'heading':
        return block.level === 2 ? (
          <h2 class="mt-10 font-display text-2xl font-bold text-ink-950 dark:text-ink-50">{block.text}</h2>
        ) : (
          <h3 class="mt-8 font-display text-xl font-bold text-ink-950 dark:text-ink-50">{block.text}</h3>
        );
      case 'paragraph':
        return <p class="mt-6">{block.text}</p>;
      case 'quote':
        return (
          <blockquote class="mt-8 border-l-4 border-accent-600 pl-5 italic text-ink-700 dark:text-ink-200">
            <p class="text-xl">“{block.text}”</p>
            {block.attribution && <cite class="mt-2 block text-sm not-italic text-ink-400">— {block.attribution}</cite>}
          </blockquote>
        );
      case 'list':
        return block.ordered ? (
          <ol class="mt-6 list-decimal space-y-2 pl-6">
            {block.items.map((item) => <li>{item}</li>)}
          </ol>
        ) : (
          <ul class="mt-6 list-disc space-y-2 pl-6">
            {block.items.map((item) => <li>{item}</li>)}
          </ul>
        );
      case 'code':
        return (
          <div class="mt-6 overflow-x-auto rounded-card bg-ink-950 p-4">
            <pre class="font-mono text-sm text-ink-100"><code>{block.code}</code></pre>
          </div>
        );
      case 'image':
        return (
          <figure class="mt-8">
            <div class="flex aspect-video items-center justify-center rounded-card border border-dashed border-ink-300 bg-ink-50 text-sm text-ink-400 dark:bg-ink-900">
              Image — arrives with the media library (Phase 8)
            </div>
            {block.caption && <figcaption class="mt-2 text-center text-sm text-ink-400">{block.caption}</figcaption>}
          </figure>
        );
      default:
        return null;
    }
  })}
</div>
