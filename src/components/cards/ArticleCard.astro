---
import type { Article } from '../../types/article';
import { getCategory, getAuthorById, formatDate } from '../../lib/sample-data';
import ImagePlaceholder from '../common/ImagePlaceholder.astro';

interface Props {
  article: Article;
  variant?: 'default' | 'horizontal' | 'compact';
}

const { article, variant = 'default' } = Astro.props;
const category = getCategory(article.categorySlug);
const author = getAuthorById(article.authorId);
---

{variant === 'default' && (
  <article class="group">
    <a href={`/article/${article.slug}`} class="block">
      <div class="aspect-video overflow-hidden rounded-card">
        <div class="h-full w-full transition-transform duration-300 group-hover:scale-[1.02]">
          <ImagePlaceholder article={article} />
        </div>
      </div>
    </a>
    <div class="mt-3">
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest">
        {article.breaking && <span class="rounded-card bg-accent-600 px-1.5 py-0.5 text-paper">Breaking</span>}
        <a href={`/topics/${category?.slug}`} class="text-accent-700 hover:underline">{category?.name}</a>
        <span class="text-ink-300">/</span>
        <span class="text-ink-400">{article.contentType}</span>
      </div>
      <h3 class="mt-2 font-display text-lg font-bold leading-snug text-ink-950">
        <a href={`/article/${article.slug}`} class="hover:text-accent-700">{article.title}</a>
      </h3>
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-600">{article.excerpt}</p>
      <p class="mt-2 text-xs text-ink-400">
        {author && <a href={`/authors/${author.slug}`} class="hover:underline">{author.name}</a>}
        · {formatDate(article.publishedAt)} · {article.readingMinutes} min read
      </p>
    </div>
  </article>
)}

{variant === 'horizontal' && (
  <article class="group flex gap-4">
    <a href={`/article/${article.slug}`} class="w-28 shrink-0 overflow-hidden rounded-card sm:w-36">
      <div class="aspect-square">
        <ImagePlaceholder article={article} />
      </div>
    </a>
    <div class="min-w-0">
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest">
        {article.breaking && <span class="rounded-card bg-accent-600 px-1.5 py-0.5 text-paper">Breaking</span>}
        <span class="text-ink-400">{category?.name}</span>
      </div>
      <h3 class="mt-1 font-display text-base font-bold leading-snug text-ink-950">
        <a href={`/article/${article.slug}`} class="hover:text-accent-700">{article.title}</a>
      </h3>
      <p class="mt-1 text-xs text-ink-400">
        {formatDate(article.publishedAt)} · {article.readingMinutes} min read
      </p>
    </div>
  </article>
)}

{variant === 'compact' && (
  <article class="border-b border-ink-100 pb-4">
    <div class="text-xs font-semibold uppercase tracking-widest text-ink-400">{category?.name}</div>
    <h3 class="mt-1 font-display text-base font-bold leading-snug text-ink-950">
      <a href={`/article/${article.slug}`} class="hover:text-accent-700">{article.title}</a>
    </h3>
    <p class="mt-1 text-xs text-ink-400">
      {author?.name} · {article.readingMinutes} min read
    </p>
  </article>
)}
