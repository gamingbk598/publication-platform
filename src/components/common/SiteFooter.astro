---
const year = new Date().getFullYear();
const sections = [
  { heading: 'Sections', links: [
    { href: '/news', label: 'News' },
    { href: '/articles', label: 'Articles' },
    { href: '/topics', label: 'All topics' },
    { href: '/authors', label: 'Authors' },
  ]},
  { heading: 'Types', links: [
    { href: '/opinions', label: 'Opinion' },
    { href: '/guides', label: 'Guides' },
    { href: '/reviews', label: 'Reviews' },
    { href: '/search', label: 'Search' },
  ]},
];
---

<footer class="border-t border-ink-200 bg-paper">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-xl font-bold text-ink-950">Did You Hear?</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-500">
        A blogging and news channel: multi-author reporting, explainers, and takes
        worth sharing. Editorial and corrections policies will be published here.
      </p>
    </div>
    {sections.map((section) => (
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-ink-400">{section.heading}</p>
        <ul class="mt-3 space-y-2 text-sm text-ink-600">
          {section.links.map((link) => (
            <li><a href={link.href} class="hover:text-ink-950">{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-ink-200">
    <div class="mx-auto flex max-w-6xl flex-col justify-between gap-2 px-4 py-5 text-xs text-ink-400 sm:flex-row">
      <span>&copy; {year} Did You Hear?. All rights reserved.</span>
      <span>Powered by Astro on Cloudflare Workers.</span>
    </div>
  </div>
</footer>
