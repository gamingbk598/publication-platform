---
const navItems = [
  { href: '/news', label: 'News' },
  { href: '/articles', label: 'Articles' },
  { href: '/opinions', label: 'Opinions' },
  { href: '/guides', label: 'Guides' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/topics', label: 'Topics' },
  { href: '/authors', label: 'Authors' },
];
---

<header class="border-b border-ink-200 bg-paper">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex items-center justify-between py-3">
      <a
        href="/"
        class="font-display text-xl font-bold tracking-tight text-ink-950 md:text-2xl"
        aria-label="Did You Hear? — home"
      >
        Did You Hear?
      </a>

      <div class="flex items-center gap-3">
        <form action="/search" method="get" role="search" class="relative">
          <input
            type="search"
            name="q"
            placeholder="Search…"
            aria-label="Search articles"
            class="w-36 rounded-card border border-ink-200 bg-white px-3 py-1.5 text-sm text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none md:w-52"
          />
        </form>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="rounded-card border border-ink-200 p-2 text-ink-600 hover:bg-ink-100"
        >
          <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
          </svg>
          <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
          </svg>
        </button>
      </div>
    </div>

    <nav aria-label="Main" class="flex items-center gap-5 overflow-x-auto pb-3 text-sm font-medium text-ink-600">
      {navItems.map((item) => <a href={item.href} class="whitespace-nowrap hover:text-ink-950">{item.label}</a>)}
    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  const apply = (dark) => {
    document.documentElement.classList.toggle('dark', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  };
  if (localStorage.getItem('theme') === 'dark') apply(true);
  toggle?.addEventListener('click', () => apply(!document.documentElement.classList.contains('dark')));
</script>
