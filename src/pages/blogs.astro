---
import PublicLayout from '../layouts/public/PublicLayout.astro';
import ListingPage from '../components/articles/ListingPage.astro';
import { getByType } from '../lib/data';

const articles = await getByType('blog');
---

<PublicLayout title="Blogs — Did You Hear?">
  <ListingPage title="Blogs" description="Personal essays and notes from our writers." articles={articles} />
</PublicLayout>
