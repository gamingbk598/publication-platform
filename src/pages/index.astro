---
import PublicLayout from '../layouts/public/PublicLayout.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import ImagePlaceholder from '../components/common/ImagePlaceholder.astro';
import {
  getFeatured,
  getLatest,
  getEditorsPicks,
  getByCategory,
  getCategory,
  getAuthorById,
  formatDate,
  categories,
} from '../lib/sample-data';

const featured = getFeatured();
const latest = getLatest(6);
const picks = getEditorsPicks(3);
const sectionCategories = categories.filter((c) => getByCategory(c.slug, 1).length > 0);
---

<PublicLayout title="Did You Hear? — Blogging and news" description="A blogging and news channel: reporting, explainers, guides, and takes worth sharing.">
  {featured && (
    <section class="mx-auto max-w-6xl px-4 pt-10">
      <a href={`/article/${featured.slug}`} class="group grid gap-6 md:grid-cols-2 md:items-center">
        <div class="aspect-video overflow-hidden rounded-card">
          <div class="h-full w-full transition-transform duration-300 group-hover:scale-[1.01]">
            <ImagePlaceholder article={featured} label="FEATURED" />
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest">
            {featured.breaking && <span class="rounded-card bg-accent-600 px-1.5 py-0.5 text-paper">Breaking</span>}
            <span class="text-accent-700">{getCategory(featured.categorySlug)?.name}</span>
            <span class="text-ink-300">/</span>
            <span class="text-ink-400">{featured.contentType}</span>
          </div>
          <h1 class="mt-3 font-display text-3xl font-bold leading-tight text-ink-950 group-hover:text-accent-700 md:text-5xl">
            {featured.title}
          </h1>
          <p class="mt-3 text-lg leading-relaxed text-ink-600">{featured.subtitle}</p>
          <p class="mt-4 text-sm text-ink-400">
            {getAuthorById(featured.authorId)?.name} · {formatDate(featured.publishedAt)} · {featured.readingMinutes} min read
          </p>
        </div>
      </a>
    </section>
  )}

  <div class="mx-auto mt-12 max-w-6xl border-t border-ink-200 px-4"></div>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h2 class="border-b border-ink-200 pb-3 font-display text-xl font-bold text-ink-950">Latest</h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        {latest.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
    <aside>
      <h2 class="border-b border-ink-200 pb-3 font-display text-xl font-bold text-ink-950">Editor’s Picks</h2>
      <div class="mt-6 space-y-5">
        {picks.map((article) => <ArticleCard article={article} variant="compact" />)}
      </div>

      <div class="mt-10 rounded-card border border-ink-200 bg-white p-6 dark:bg-ink-900">
        <h3 class="font-display text-lg font-bold text-ink-950 dark:text-ink-50">Newsletter</h3>
        <p class="mt-2 text-sm text-ink-500">
          A weekly digest of our best reporting. Subscription form arrives with the
          newsletter system.
        </p>
      </div>
    </aside>
  </section>

  {sectionCategories.map((category) => {
    const items = getByCategory(category.slug, 3);
    return (
      <section class="mx-auto max-w-6xl border-t border-ink-200 px-4 py-10">
        <div class="flex items-baseline justify-between">
          <h2 class="font-display text-xl font-bold text-ink-950">
            <a href={`/topics/${category.slug}`} class="hover:text-accent-700">{category.name}</a>
          </h2>
          <a href={`/topics/${category.slug}`} class="text-sm text-ink-500 hover:text-ink-900">View all →</a>
        </div>
        <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((article) => <ArticleCard article={article} />)}
        </div>
      </section>
    );
  })}
</PublicLayout>
