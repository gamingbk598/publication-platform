---
import PublicLayout from '../../layouts/public/PublicLayout.astro';
import { getCategories, getPublishedCountsByCategory } from '../../lib/data';

const categories = await getCategories();
const counts = await getPublishedCountsByCategory();
---

<PublicLayout title="Topics — Did You Hear?" description="Browse all coverage by topic.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-8 border-b border-ink-200 pb-4">
      <h1 class="font-display text-3xl font-bold text-ink-950 md:text-4xl">Topics</h1>
      <p class="mt-2 text-ink-600">All coverage, organized by subject.</p>
    </header>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((category) => {
        const count = counts[category.slug] ?? 0;
        return (
          <a
            href={`/topics/${category.slug}`}
            class={`group rounded-card border border-ink-200 bg-white p-6 transition-shadow hover:shadow-card dark:bg-ink-900`}
          >
            <div class={`h-1.5 w-12 rounded-full bg-gradient-to-r ${category.placeholderGradient}`}></div>
            <h2 class="mt-4 font-display text-xl font-bold text-ink-950 group-hover:text-accent-700 dark:text-ink-50">
              {category.name}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{category.description}</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-ink-400">
              {count} {count === 1 ? 'article' : 'articles'}
            </p>
          </a>
        );
      })}
    </div>
  </section>
</PublicLayout>
