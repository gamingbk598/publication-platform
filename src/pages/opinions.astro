---
import PublicLayout from '../layouts/public/PublicLayout.astro';
import ListingPage from '../components/articles/ListingPage.astro';
import { getByType } from '../lib/data';

const articles = await getByType('opinion');
---

<PublicLayout title="Opinions — Did You Hear?">
  <ListingPage
    title="Opinions"
    description="Argument and perspective — clearly labeled opinion, distinct from our reporting."
    articles={articles}
  />
</PublicLayout>
