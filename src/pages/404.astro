---
import PublicLayout from '../layouts/public/PublicLayout.astro';
---

<PublicLayout title="Page not found — Did You Hear?">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center">
    <p class="font-display text-6xl font-bold text-accent-700">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-ink-950 dark:text-ink-50">Page not found</h1>
    <p class="mt-3 text-ink-500">The page you are looking for does not exist or has moved.</p>
    <a
      href="/"
      class="mt-8 rounded-card bg-ink-900 px-5 py-2.5 text-sm font-medium text-paper hover:bg-ink-800 dark:bg-ink-100 dark:text-ink-950 dark:hover:bg-white"
    >
      Back to the homepage
    </a>
  </section>
</PublicLayout>
