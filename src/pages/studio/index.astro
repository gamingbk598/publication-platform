---
import DashboardLayout from '../../layouts/dashboard/DashboardLayout.astro';
import InvitationManager from '../../components/studio/InvitationManager';

/**
 * /studio — the dashboard home. The middleware guarantees a signed-in,
 * active member here (locals.profile). Sessions, roles, the invitation
 * system, and the Phase 4 article tools all live behind this screen.
 */

const profile = Astro.locals.profile!;
const user = Astro.locals.user!;
const isEditorOrAbove = profile.role === 'owner' || profile.role === 'editor';
---

<DashboardLayout title="Dashboard — Did You Hear? Studio">
  <div class="space-y-6">
    <div class="rounded-card border border-ink-200 bg-white p-8">
      <h1 class="font-display text-2xl font-bold text-ink-950">
        Welcome back, {profile.display_name}
      </h1>
      <p class="mt-2 text-sm text-ink-600">
        Signed in as <strong>{user.email}</strong>
        {profile.role === 'owner' && (
          <>
            {' '}— you are the <strong>owner</strong> of this publication. You manage the
            team, settings, and can do everything editors and authors do.
          </>
        )}
        {profile.role === 'editor' && (
          <>
            {' '}— as an <strong>editor</strong> you review, edit, and publish articles, and
            can invite new authors.
          </>
        )}
        {profile.role === 'author' && (
          <>
            {' '}— as an <strong>author</strong> you write and submit articles for review.
            Publishing is done by editors.
          </>
        )}
      </p>
    </div>

    {
      isEditorOrAbove ? (
        <div class="rounded-card border border-ink-200 bg-white p-8">
          <h2 class="font-display text-lg font-bold text-ink-950">Team invitations</h2>
          <p class="mt-1 mb-6 text-sm text-ink-500">
            Invite-only membership: create an invitation, copy the one-time link, and send
            it to the person yourself. Links expire after 7 days.
          </p>
          <InvitationManager canInviteEditors={profile.role === 'owner'} />
        </div>
      ) : null
    }

    <div class="rounded-card border border-ink-200 bg-white p-8">
      <h2 class="font-display text-lg font-bold text-ink-950">Start writing</h2>
      <p class="mt-2 max-w-xl text-sm text-ink-600">
        The article editor is live: structured blocks, drafts, submission, and the full
        editorial review workflow.
      </p>
      <a
        href="/studio/articles"
        class="mt-4 inline-block rounded-card bg-ink-950 px-4 py-2 text-sm font-semibold text-paper transition hover:bg-ink-800"
      >
        Open the article list →
      </a>
    </div>
  </div>
</DashboardLayout>
