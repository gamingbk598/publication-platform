---
import DashboardLayout from '../../layouts/dashboard/DashboardLayout.astro';
---

<DashboardLayout title="Studio — Dashboard">
  <div class="rounded-card border border-ink-200 bg-white p-8">
    <h1 class="font-display text-2xl font-bold text-ink-950">Editorial Studio</h1>
    <p class="mt-2 max-w-xl text-ink-600">
      The CMS dashboard will be built in Phase 4 (management screens) and Phase 5 (the full
      editorial workflow). Authentication and route protection arrive in Phase 3. This page
      exists so the dashboard layout and design system can be verified early.
    </p>
  </div>
</DashboardLayout>
