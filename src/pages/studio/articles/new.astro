---
import DashboardLayout from '../../../layouts/dashboard/DashboardLayout.astro';
import ArticleEditor from '../../../components/studio/ArticleEditor';

/**
 * /studio/articles/new — start a fresh draft. Categories and existing tags
 * are fetched server-side (RLS: readable by everyone) and handed to the
 * editor island; saving POSTs to /api/studio/articles as the signed-in user.
 */

const sb = Astro.locals.supabase!;
const profile = Astro.locals.profile!;

const [{ data: categories }, { data: tags }] = await Promise.all([
  sb.from('categories').select('id, name').eq('is_active', true).order('display_order'),
  sb.from('tags').select('name').order('name').limit(100),
]);
---

<DashboardLayout title="New article — Did You Hear? Studio">
  <div class="mb-6">
    <a href="/studio/articles" class="text-xs font-semibold text-ink-500 hover:text-ink-800">
      ← Back to articles
    </a>
    <h1 class="mt-1 font-display text-2xl font-bold text-ink-950">New article</h1>
  </div>
  <ArticleEditor
    mode="create"
    categories={(categories ?? []).map((c) => ({ id: c.id, name: c.name }))}
    existingTags={(tags ?? []).map((t) => t.name)}
    role={profile.role}
  />
</DashboardLayout>
