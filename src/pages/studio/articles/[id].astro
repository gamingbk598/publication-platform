---
import DashboardLayout from '../../../layouts/dashboard/DashboardLayout.astro';
import ArticleEditor, {
  type EditorArticle,
  type ReviewEntry,
} from '../../../components/studio/ArticleEditor';
import type { ContentBlock } from '../../../types/article';

/**
 * /studio/articles/[id] — open one article in the editor.
 *
 * The load runs under the signed-in user's session, so RLS already decides
 * who may see this row: the author, or any editor. Everyone else gets a 404.
 */

const sb = Astro.locals.supabase!;
const profile = Astro.locals.profile!;
const id = Astro.params.id!;

const { data: article } = await sb
  .from('articles')
  .select(
    `id, slug, title, subtitle, excerpt, content_type, category_id, status, body,
     featured, editors_pick, breaking, event_date, location, scheduled_at,
     article_tags(tags(name))`,
  )
  .eq('id', id)
  .maybeSingle();

if (!article) return Astro.redirect('/studio/articles');

const [{ data: categories }, { data: tags }, { data: reviews }] = await Promise.all([
  sb.from('categories').select('id, name').eq('is_active', true).order('display_order'),
  sb.from('tags').select('name').order('name').limit(100),
  sb
    .from('editorial_reviews')
    .select('id, decision, comment, is_author_response, created_at, reviewer:profiles(display_name)')
    .eq('article_id', id)
    .order('created_at', { ascending: true })
    .limit(100),
]);

const editorArticle: EditorArticle = {
  id: article.id,
  slug: article.slug,
  title: article.title,
  subtitle: article.subtitle ?? '',
  excerpt: article.excerpt ?? '',
  contentType: article.content_type,
  categoryId: article.category_id ?? '',
  status: article.status,
  tags: (article.article_tags ?? []).map((t) => t.tags?.name).filter(Boolean),
  body: Array.isArray(article.body) ? (article.body as ContentBlock[]) : [],
  eventDate: article.event_date ?? '',
  location: article.location ?? '',
  featured: article.featured,
  editorsPick: article.editors_pick,
  breaking: article.breaking,
  scheduledAt: article.scheduled_at,
};
---

<DashboardLayout title={`${article.title} — Did You Hear? Studio`}>
  <div class="mb-6">
    <a href="/studio/articles" class="text-xs font-semibold text-ink-500 hover:text-ink-800">
      ← Back to articles
    </a>
    <h1 class="mt-1 font-display text-2xl font-bold text-ink-950">Edit article</h1>
    <p class="mt-1 text-xs text-ink-400">/article/{article.slug}</p>
  </div>
  <ArticleEditor
    client:load
    mode="edit"
    article={editorArticle}
    categories={(categories ?? []).map((c) => ({ id: c.id, name: c.name }))}
    existingTags={(tags ?? []).map((t) => t.name)}
    role={profile.role}
    reviews={(reviews ?? []) as unknown as ReviewEntry[]}
  />
</DashboardLayout>
