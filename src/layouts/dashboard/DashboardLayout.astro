---
import '../../styles/global.css';
import type { StudioProfile } from '../../middleware';

/**
 * Shell for every authenticated /studio page. Reads the profile the
 * middleware attached to locals — pages never fetch it themselves.
 */

interface Props {
  title: string;
}

const { title } = Astro.props;
const profile: StudioProfile | null = Astro.locals.profile ?? null;
const currentPath = Astro.url.pathname;
/** `navCls(href)` = exact match; `navCls(href, true)` = section prefix match. */
const navCls = (href: string, section = false) =>
  currentPath === href || (section && currentPath.startsWith(`${href}/`))
    ? 'block rounded-card bg-ink-100 px-3 py-2 text-ink-900'
    : 'block rounded-card px-3 py-2 text-ink-600 transition hover:bg-ink-50 hover:text-ink-900';

const roleBadge =
  profile?.role === 'owner'
    ? 'bg-accent-50 text-accent-700 border-accent-200'
    : profile?.role === 'editor'
      ? 'bg-ink-100 text-ink-700 border-ink-300'
      : 'bg-ink-50 text-ink-500 border-ink-200';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-ink-50 font-sans text-ink-900">
    <div class="flex min-h-dvh">
      <aside class="hidden w-60 shrink-0 border-r border-ink-200 bg-white p-4 md:block">
        <a href="/" class="font-display text-xl font-bold text-ink-950 hover:text-ink-700">
          Did You Hear?
        </a>
        <p class="mt-0.5 text-xs uppercase tracking-wide text-ink-400">Studio</p>
        <nav class="mt-6 space-y-1 text-sm font-medium">
          <a href="/studio" class={navCls('/studio')}>Dashboard</a>
          <a href="/studio/articles" class={navCls('/studio/articles', true)}>
            Articles
          </a>
          <span class="block cursor-default px-3 py-2 text-ink-300" title="Coming in Phase 8 (R2 media)">
            Media
          </span>
          {profile?.role !== 'author' && (
            <span class="block cursor-default px-3 py-2 text-ink-300" title="Team lives on the dashboard">
              Team
            </span>
          )}
          {profile?.role === 'owner' && (
            <span class="block cursor-default px-3 py-2 text-ink-300" title="Coming in Phase 4">
              Settings
            </span>
          )}
          <a
            href="/"
            class="mt-4 block px-3 py-2 text-xs text-ink-400 transition hover:text-ink-700"
          >
            ← View public site
          </a>
        </nav>
      </aside>
      <div class="flex flex-1 flex-col">
        <header class="flex items-center justify-between border-b border-ink-200 bg-white px-6 py-3">
          <p class="text-sm text-ink-500">Editorial management</p>
          {profile && (
            <div class="flex items-center gap-3">
              <div class="text-right">
                <p class="text-sm font-semibold leading-tight text-ink-900">
                  {profile.display_name}
                </p>
                <p class="text-xs leading-tight text-ink-400">@{profile.username}</p>
              </div>
              <span
                class={`rounded-full border px-2.5 py-0.5 text-xs font-medium capitalize ${roleBadge}`}
              >
                {profile.role}
              </span>
              <form method="post" action="/api/studio/auth/signout">
                <button
                  type="submit"
                  class="rounded-card border border-ink-200 px-3 py-1.5 text-xs font-semibold text-ink-600 transition hover:bg-ink-100"
                >
                  Sign out
                </button>
              </form>
            </div>
          )}
        </header>
        <main class="flex-1 p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
