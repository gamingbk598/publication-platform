---
import '../../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-ink-50 font-sans text-ink-900">
    <div class="flex min-h-dvh">
      <aside class="hidden w-60 shrink-0 border-r border-ink-200 bg-white p-4 md:block">
        <p class="font-display text-xl font-bold text-ink-950">Studio</p>
        <nav class="mt-6 space-y-1 text-sm font-medium text-ink-600">
          <p class="rounded-card bg-ink-100 px-3 py-2 text-ink-900">Dashboard</p>
          <!-- CMS navigation is built in Phase 4. -->
        </nav>
      </aside>
      <div class="flex flex-1 flex-col">
        <header class="border-b border-ink-200 bg-white px-6 py-4">
          <p class="text-sm text-ink-500">Editorial management</p>
        </header>
        <main class="flex-1 p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
