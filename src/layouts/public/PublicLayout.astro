---
import '../../styles/global.css';
import SiteHeader from '../../components/navigation/SiteHeader.astro';
import SiteFooter from '../../components/common/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A blogging and news channel — stories you will actually want to talk about.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col bg-paper font-sans text-ink-900 dark:bg-ink-950 dark:text-ink-50">
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
