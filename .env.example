# ── Public variables (safe to expose in the browser) ──────────────────────
# PUBLIC_ prefix means Astro embeds them in client code. Real Supabase values
# arrive in Phase 3 — leave empty until then.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only secrets (NEVER expose these to the browser) ───────────────
# The Supabase service-role key bypasses Row Level Security. It is used ONLY
# inside server endpoints. In production it lives in the Cloudflare dashboard
# as an encrypted secret, never in this file.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (Phase 8) ───────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
